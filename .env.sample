# Copy this file to .env and fill in your values:
#   cp .env.sample .env        (macOS / Linux)
#   copy .env.sample .env      (Windows Command Prompt)
#   Copy-Item .env.sample .env (Windows PowerShell)
#
# Never commit your real .env file — it is listed in .gitignore.

GITHUB_TOKEN=ghp_your_token_here
GROQ_API_KEY=gsk_your_key_here

# Optional — Groq chat model (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=qwen/qwen3.6-27b
